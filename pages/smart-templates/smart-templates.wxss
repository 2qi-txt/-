/* pages/smart-templates/smart-templates.wxss - 电竞风格 */
.container {
  padding: 40rpx 30rpx 60rpx;
  min-height: 100vh;
}

/* 标题栏 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 0;
  position: relative;
}

.header::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, var(--primary-glow), transparent);
  opacity: 0.3;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary-light);
  text-shadow: 0 0 30rpx var(--primary-glow);
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  position: relative;
  z-index: 1;
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #fff;
  font-weight: bold;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
}

.tab-item:first-child.active {
  border-radius: 14rpx 0 0 14rpx;
}

.tab-item:last-child.active {
  border-radius: 0 14rpx 14rpx 0;
}

/* 内容区域 */
.content {
  margin-top: 24rpx;
}

/* 用户资料卡片 */
.profile-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.major {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.grade {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

.update-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: white;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 12rpx var(--primary-glow);
}

.interests {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-right: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(99, 102, 241, 0.1));
  border: 1rpx solid var(--primary);
  color: var(--primary-light);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 区块标题 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-light);
  margin-bottom: 20rpx;
}

.refresh-btn {
  font-size: 28rpx;
  color: var(--primary-light);
  padding: 8rpx;
}

/* 模板列表 */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.template-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.2);
  transition: all 0.3s ease;
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.template-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}

.template-card.personalized {
  border-left: 6rpx solid var(--primary);
}

.template-card.hot {
  border-left: 6rpx solid #f87171;
}

.template-card.seasonal {
  border-left: 6rpx solid #2dd4bf;
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.template-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  flex: 1;
}

.match-score {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.hot-badge {
  background: linear-gradient(135deg, #f87171, #ef4444);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.seasonal-badge {
  background: linear-gradient(135deg, #2dd4bf, #14b8a6);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.category-badge {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.8);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.template-content {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.template-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reason {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  flex: 1;
}

.stats {
  display: flex;
  gap: 20rpx;
  flex: 1;
}

.usage, .rating {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  background: rgba(255,255,255,0.2);
  transform: scale(0.95);
}

/* 搜索区域 */
.search-section {
  margin-top: 24rpx;
}

.search-bar {
  display: flex;
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  background: transparent;
}

.search-btn {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  margin-left: 16rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .template-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12rpx;
  }
  
  .template-footer {
    flex-direction: column;
    gap: 16rpx;
    align-items: flex-start;
  }
  
  .actions {
    align-self: flex-end;
  }
}
