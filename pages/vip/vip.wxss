/* 贵族中心：王者荣耀电竞风格 */

/* 貂蝉主题 */
.skin-libai {
  --primary: #ec4899;
  --primary-light: #f9a8d4;
  --primary-glow: rgba(236, 72, 153, 0.4);
  --card-bg: rgba(15, 15, 23, 0.9);
  --card-border: rgba(236, 72, 153, 0.3);
}

/* 赵云主题 */
.skin-zhaoyun {
  --primary: #3b82f6;
  --primary-light: #93c5fd;
  --primary-glow: rgba(59, 130, 246, 0.4);
  --card-bg: rgba(15, 23, 42, 0.9);
  --card-border: rgba(59, 130, 246, 0.3);
}

/* 凯主题 */
.skin-kai {
  --primary: #10b981;
  --primary-light: #6ee7b7;
  --primary-glow: rgba(16, 185, 129, 0.4);
  --card-bg: rgba(15, 23, 42, 0.9);
  --card-border: rgba(16, 185, 129, 0.3);
}

/* 默认/暗色主题 */
.skin-default, .dark-theme, .default-theme {
  --primary: #7e22ce;
  --primary-light: #a855f7;
  --primary-glow: rgba(126, 34, 206, 0.4);
  --card-bg: rgba(15, 15, 23, 0.9);
  --card-border: rgba(194, 156, 74, 0.3);
}

/* 彩色主题 */
.skin-colorful, .colorful-theme {
  --primary: #a855f7;
  --primary-light: #c084fc;
  --primary-glow: rgba(168, 85, 247, 0.4);
  --card-bg: rgba(30, 20, 50, 0.9);
  --card-border: rgba(168, 85, 247, 0.3);
}

.container {
  padding-bottom: 60rpx;
}

.esports-header {
  padding: 40rpx 30rpx 60rpx;
  background: linear-gradient(180deg, var(--card-bg) 0%, transparent 100%);
  position: relative;
}

.esports-header::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--primary-light), transparent);
  opacity: 0.3;
}

/* 贵族卡片 */
.vip-section {
  padding: 0 30rpx;
  margin-top: -40rpx;
}

.vip-active-card {
  padding: 40rpx;
  background: linear-gradient(135deg, rgba(15, 15, 23, 0.95) 0%, rgba(126, 34, 206, 0.2) 100%) !important;
}

.noble-active {
  border-color: var(--primary-gold) !important;
  box-shadow: 0 0 30rpx rgba(251, 191, 36, 0.3) !important;
}

.vip-card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.noble-badge {
  width: 60rpx;
  height: 60rpx;
  background: var(--metal-gradient);
  color: #000;
  font-size: 40rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-style: italic;
}

.vip-card-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-gold);
  flex: 1;
}

.vip-expire {
  font-size: 20rpx;
  color: #64748b;
}

.vip-card-body {
  display: flex;
  justify-content: space-around;
}

.vip-quota-item {
  text-align: center;
}

.quota-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 10rpx;
}

.quota-value {
  font-size: 48rpx;
  font-weight: 900;
  margin-bottom: 6rpx;
}

.quota-used {
  font-size: 18rpx;
  color: #64748b;
}

/* 贵族权益 */
.benefits-section {
  padding: 40rpx 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.header-text {
  font-size: 32rpx;
  color: var(--text-gold);
  font-weight: bold;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.benefit-item {
  background: rgba(15, 15, 23, 0.4);
  border: 1rpx solid rgba(194, 156, 74, 0.1);
  padding: 30rpx 20rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.benefit-icon {
  font-size: 50rpx;
  margin-bottom: 16rpx;
}

.benefit-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.benefit-desc {
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.4;
}

/* 订阅方案 */
.plans-section {
  padding: 0 30rpx 60rpx;
}

.plans-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
}

.featured-plan {
  border-color: var(--primary-purple) !important;
  background: rgba(126, 34, 206, 0.1) !important;
}

.plan-info {
  flex: 1;
}

.plan-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.plan-price {
  margin-bottom: 4rpx;
}

.price-val {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
  margin-right: 12rpx;
}

.price-origin {
  font-size: 22rpx;
  color: #64748b;
  text-decoration: line-through;
}

.plan-desc {
  font-size: 20rpx;
  color: #94a3b8;
}

.buy-btn {
  width: 180rpx !important;
  height: 72rpx !important;
  font-size: 24rpx !important;
  padding: 0 !important;
  border-radius: 36rpx !important;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%) !important;
  border: none !important;
  color: #fff !important;
  box-shadow: 0 4rpx 16rpx var(--primary-glow) !important;
}

.buy-btn:active {
  transform: scale(0.95) !important;
  filter: brightness(1.1) !important;
}

/* 底部操作按钮 */
.actions {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}

.actions .btn {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.actions .btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  border: none;
  color: #fff;
  box-shadow: 0 8rpx 24rpx var(--primary-glow);
}

.actions .btn-primary::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 8%;
  right: 8%;
  height: 40%;
  background: linear-gradient(180deg, rgba(255,255,255,0.2), transparent);
  border-radius: 48rpx 48rpx 50% 50%;
}

.actions .btn-primary:active {
  transform: scale(0.97);
  filter: brightness(1.1);
}

.actions .btn-secondary {
  background: rgba(255,255,255,0.05);
  border: 2rpx solid var(--card-border);
  color: var(--primary-light);
}

.actions .btn-secondary:active {
  background: rgba(255,255,255,0.1);
  transform: scale(0.97);
}

.actions .btn-danger {
  background: rgba(239, 68, 68, 0.1);
  border: 2rpx solid rgba(239, 68, 68, 0.3);
  color: #ef4444;
  font-size: 24rpx !important;
  height: 72rpx !important;
}

.actions .btn-disabled {
  opacity: 0.5;
}