<view class="container {{themeClass}}">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-title">文案详情</view>
    <view class="page-actions">
      <button class="action-btn" bindtap="copyContent">复制</button>
      <button class="action-btn" bindtap="shareContent">分享</button>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
    <view class="content-card">
      <view class="content-header">
        <view class="content-title">{{content.title}}</view>
        <view class="content-meta">
          <view class="meta-item">
            <text class="meta-icon">🏷️</text>
            <text class="meta-text">{{content.type}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">⏰</text>
            <text class="meta-text">{{content.time}}</text>
          </view>
          <view class="meta-item" wx:if="{{content.scene}}">
            <text class="meta-icon">📍</text>
            <text class="meta-text">{{content.scene}}</text>
          </view>
        </view>
      </view>
      
      <view class="content-body">
        <text class="content-text">{{content.content}}</text>
      </view>
      
      <view class="content-footer">
        <view class="content-stats">
          <view class="stat-item">
            <text class="stat-icon">👁️</text>
            <text class="stat-text">{{content.views || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">👍</text>
            <text class="stat-text">{{content.likes || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">💬</text>
            <text class="stat-text">{{content.comments || 0}}</text>
          </view>
        </view>
        
        <view class="content-actions">
          <button class="action-btn secondary" bindtap="toggleFavorite">
            <text class="action-icon">{{content.isFavorite ? '❤️' : '🤍'}}</text>
            <text class="action-text">{{content.isFavorite ? '已收藏' : '收藏'}}</text>
          </button>
          <button class="action-btn secondary" bindtap="editContent">
            <text class="action-icon">✏️</text>
            <text class="action-text">编辑</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 相关推荐 -->
  <view class="recommend-section" wx:if="{{recommendList.length > 0}}">
    <view class="section-title">相关推荐</view>
    <view class="recommend-list">
      <view class="recommend-item" wx:for="{{recommendList}}" wx:key="id" bindtap="openRecommend" data-item="{{item}}">
        <view class="recommend-content">
          <view class="recommend-title">{{item.title}}</view>
          <view class="recommend-desc">{{item.desc}}</view>
        </view>
        <view class="recommend-arrow">></view>
      </view>
    </view>
  </view>

  <!-- 评论区域 -->
  <view class="comment-section">
    <view class="section-title">评论 ({{commentList.length}})</view>
    <view class="comment-list">
      <view class="comment-item" wx:for="{{commentList}}" wx:key="id">
        <view class="comment-avatar">
          <image src="{{item.avatar}}" class="avatar-img"></image>
        </view>
        <view class="comment-content">
          <view class="comment-header">
            <view class="comment-name">{{item.name}}</view>
            <view class="comment-time">{{item.time}}</view>
          </view>
          <view class="comment-text">{{item.content}}</view>
          <view class="comment-actions">
            <button class="comment-btn" bindtap="likeComment" data-id="{{item.id}}">
              <text class="comment-icon">👍</text>
              <text class="comment-count">{{item.likes || 0}}</text>
            </button>
            <button class="comment-btn" bindtap="replyComment" data-id="{{item.id}}">
              <text class="comment-icon">💬</text>
              <text class="comment-text">回复</text>
            </button>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 添加评论 -->
    <view class="add-comment">
      <input class="comment-input" placeholder="写下你的评论..." value="{{newComment}}" bindinput="onCommentInput" />
      <button class="comment-submit" bindtap="submitComment">发送</button>
    </view>
  </view>
</view>



