/* 首页：王者荣耀电竞风格 */

/* 主题变量定义 */
.skin-libai {
  --primary: #6366f1;
  --primary-light: #818cf8;
  --primary-glow: rgba(99, 102, 241, 0.5);
  --accent: #c4b5fd;
  --card-bg: rgba(30, 30, 50, 0.6);
  --card-border: rgba(99, 102, 241, 0.3);
  --bg-start: #0a0a12;
  --bg-end: #0d0d18;
}

.skin-diaochan {
  --primary: #ec4899;
  --primary-light: #f472b6;
  --primary-glow: rgba(236, 72, 153, 0.5);
  --accent: #fbcfe8;
  --card-bg: rgba(50, 30, 40, 0.6);
  --card-border: rgba(236, 72, 153, 0.3);
  --bg-start: #1a0a14;
  --bg-end: #2d1f3d;
}

.skin-lan {
  --primary: #0891b2;
  --primary-light: #06b6d4;
  --primary-glow: rgba(8, 145, 178, 0.5);
  --accent: #a5f3fc;
  --card-bg: rgba(20, 40, 50, 0.6);
  --card-border: rgba(8, 145, 178, 0.3);
  --bg-start: #061018;
  --bg-end: #0c1a2e;
}

.skin-caiwenji {
  --primary: #f59e0b;
  --primary-light: #fbbf24;
  --primary-glow: rgba(245, 158, 11, 0.5);
  --accent: #fef3c7;
  --card-bg: rgba(50, 40, 20, 0.6);
  --card-border: rgba(245, 158, 11, 0.3);
  --bg-start: #1a1008;
  --bg-end: #2d2410;
}

.container {
  padding: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-start) 0%, var(--bg-end) 50%, var(--bg-start) 100%);
  transition: background 0.5s ease;
}

/* Banner 区域 */
.hero-banner {
  height: 360rpx;
  position: relative;
  background: linear-gradient(180deg, var(--primary-glow) 0%, transparent 100%);
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  overflow: hidden;
}

.hero-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center top, var(--primary-glow) 0%, transparent 60%);
  opacity: 0.3;
}

.hero-content {
  z-index: 2;
  position: relative;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #fff 0%, var(--primary-light) 50%, var(--primary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 40rpx var(--primary-glow);
  letter-spacing: 4rpx;
}

.hero-edition {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
  letter-spacing: 6rpx;
  margin-top: 8rpx;
}

.hero-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  color: var(--primary-light);
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.hero-decoration {
  position: absolute;
  right: -80rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 320rpx;
  height: 320rpx;
  opacity: 0.15;
}

.rune-circle {
  width: 100%;
  height: 100%;
  border: 30rpx double var(--primary);
  border-radius: 50%;
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 主功能卡片 */
.main-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx;
  margin-top: -32rpx;
}

.action-card {
  flex: 1;
  height: 160rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx var(--primary-glow);
}

.action-inner {
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.primary-action {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
}

.secondary-action {
  background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
  border: 1rpx solid var(--card-border);
}

.action-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.action-info {
  flex: 1;
}

.action-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.action-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 模式选择 */
.mode-selection {
  padding: 40rpx 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.header-line {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent, var(--card-border), transparent);
}

.header-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.mode-item {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.mode-item:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.08);
}

.mode-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border: 2rpx solid var(--card-border);
}

.notice-bg { background: rgba(59, 130, 246, 0.15); }
.announcement-bg { background: rgba(16, 185, 129, 0.15); }
.club-bg { background: rgba(245, 158, 11, 0.15); }
.social-bg { background: rgba(239, 68, 68, 0.15); }

.mode-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mode-level {
  font-size: 18rpx;
  color: var(--primary-light);
}

/* 战绩列表 */
.history-section {
  padding: 0 40rpx 40rpx;
}

.history-list {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: background 0.2s ease;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.history-rank {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  font-weight: 900;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.history-info {
  flex: 1;
}

.history-title {
  font-size: 26rpx;
  color: #fff;
  margin-bottom: 6rpx;
}

.history-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.history-arrow {
  color: var(--primary);
  font-size: 24rpx;
}

/* 赛季统计 */
.season-stats {
  padding: 0 40rpx 60rpx;
}

.game-style-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
}

.stats-header {
  font-size: 22rpx;
  color: var(--primary-light);
  text-align: center;
  margin-bottom: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.stats-body {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  text-align: center;
}

.stats-val {
  font-size: 44rpx;
  font-weight: 900;
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 页面动画 */
.page-enter {
  animation: pageFadeIn 0.6s ease;
}

@keyframes pageFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
