<!--pages/gamification/gamification.wxml-->
<view class="container {{themeClass}}">
  <!-- 标题栏 -->
  <view class="header">
    <view class="title">游戏化中心</view>
    <view class="subtitle">完成任务，解锁成就，提升等级</view>
  </view>

  <!-- 标签页 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'profile' ? 'active' : ''}}" 
          data-tab="profile" bindtap="switchTab">
      个人资料
    </view>
    <view class="tab-item {{currentTab === 'achievements' ? 'active' : ''}}" 
          data-tab="achievements" bindtap="switchTab">
      成就
    </view>
    <view class="tab-item {{currentTab === 'tasks' ? 'active' : ''}}" 
          data-tab="tasks" bindtap="switchTab">
      任务
    </view>
    <view class="tab-item {{currentTab === 'leaderboard' ? 'active' : ''}}" 
          data-tab="leaderboard" bindtap="switchTab">
      排行榜
    </view>
  </view>

  <!-- 个人资料页面 -->
  <view class="content" wx:if="{{currentTab === 'profile'}}">
    <!-- 用戶資料卡片 -->
    <view class="profile-card">
      <view class="profile-header">
        <view class="avatar-section">
          <view class="avatar">👤</view>
          <view class="level-badge">Lv.{{userProfile.level}}</view>
        </view>
        <view class="profile-info">
          <text class="username">文案大师</text>
          <text class="points">💎 {{userProfile.points}} 积分</text>
        </view>
      </view>
      
      <!-- 经验值条 -->
      <view class="experience-bar">
        <view class="exp-label">经验值</view>
        <view class="exp-bar">
          <view class="exp-fill" style="width: {{userProfile.experience / 200 * 100}}%"></view>
        </view>
        <text class="exp-text">{{userProfile.experience}}/200</text>
      </view>
      
      <!-- 连续使用天数 -->
      <view class="streak-section">
        <text class="streak-label">🔥 连续使用 {{userProfile.streak}} 天</text>
      </view>
    </view>

    <!-- 统计数据 -->
    <view class="stats-section">
      <view class="section-title">📊 数据统计</view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-number">{{stats.totalGenerated}}</text>
          <text class="stat-label">已生成</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{stats.totalOptimized}}</text>
          <text class="stat-label">已优化</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{stats.totalShared}}</text>
          <text class="stat-label">已分享</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{stats.totalFavorites}}</text>
          <text class="stat-label">已收藏</text>
        </view>
      </view>
    </view>

    <!-- 最近成就 -->
    <view class="recent-achievements">
      <view class="section-title">🏆 最近成就</view>
      <view class="achievement-list">
        <view class="achievement-item" 
              wx:for="{{achievements}}" 
              wx:key="id"
              wx:if="{{item.isUnlocked}}">
          <view class="achievement-icon">{{item.icon}}</view>
          <view class="achievement-info">
            <text class="achievement-title">{{item.title}}</text>
            <text class="achievement-date">{{item.unlockedAt}}</text>
          </view>
          <view class="achievement-points">+{{item.points}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 成就頁面 -->
  <view class="content" wx:if="{{currentTab === 'achievements'}}">
    <view class="achievements-grid">
      <view class="achievement-card {{item.isUnlocked ? 'unlocked' : ''}}" 
            wx:for="{{achievements}}" 
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="viewAchievementDetail">
        <view class="achievement-icon">{{item.icon}}</view>
        <view class="achievement-title">{{item.title}}</view>
        <view class="achievement-description">{{item.description}}</view>
        
        <!-- 进度条 -->
        <view class="achievement-progress" wx:if="{{!item.isUnlocked}}">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.progress / item.target * 100}}%"></view>
          </view>
          <text class="progress-text">{{item.progress}}/{{item.target}}</text>
        </view>
        
        <!-- 已解锁标记 -->
        <view class="unlocked-badge" wx:if="{{item.isUnlocked}}">✓ 已解锁</view>
        
        <view class="achievement-points">+{{item.points}} 积分</view>
      </view>
    </view>
  </view>

  <!-- 任务页面 -->
  <view class="content" wx:if="{{currentTab === 'tasks'}}">
    <!-- 每日任務 -->
    <view class="section">
      <view class="section-title">📅 每日任务</view>
      <view class="task-list">
        <view class="task-item {{item.isCompleted ? 'completed' : ''}}" 
              wx:for="{{dailyTasks}}" 
              wx:key="id">
          <view class="task-icon">{{item.icon}}</view>
          <view class="task-content">
            <view class="task-title">{{item.title}}</view>
            <view class="task-description">{{item.description}}</view>
            <view class="task-progress" wx:if="{{!item.isCompleted}}">
              <text class="progress-text">{{item.progress}}/{{item.target}}</text>
            </view>
          </view>
          <view class="task-actions">
            <view class="task-points">+{{item.points}}</view>
            <view class="task-btn {{item.isCompleted ? 'completed' : 'claim'}}" 
                  data-id="{{item.id}}"
                  bindtap="completeDailyTask"
                  wx:if="{{!item.isCompleted}}">
              {{item.isCompleted ? '已完成' : '领取'}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 周挑战 -->
    <view class="section">
      <view class="section-title">🏆 周挑战</view>
      <view class="challenge-list">
        <view class="challenge-item {{item.isCompleted ? 'completed' : ''}}" 
              wx:for="{{weeklyChallenges}}" 
              wx:key="id">
          <view class="challenge-icon">{{item.icon}}</view>
          <view class="challenge-content">
            <view class="challenge-title">{{item.title}}</view>
            <view class="challenge-description">{{item.description}}</view>
            <view class="challenge-progress">
              <view class="progress-bar">
                <view class="progress-fill" style="width: {{item.progress / item.target * 100}}%"></view>
              </view>
              <text class="progress-text">{{item.progress}}/{{item.target}}</text>
            </view>
            <view class="challenge-deadline">截止：{{item.deadline}}</view>
          </view>
          <view class="challenge-actions">
            <view class="challenge-points">+{{item.points}}</view>
            <view class="challenge-btn {{item.isCompleted ? 'completed' : 'claim'}}" 
                  data-id="{{item.id}}"
                  bindtap="claimWeeklyChallenge">
              {{item.isCompleted ? '已完成' : '领取'}}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 排行榜页面 -->
  <view class="content" wx:if="{{currentTab === 'leaderboard'}}">
    <view class="leaderboard-header">
      <view class="section-title">🏆 排行榜</view>
      <view class="leaderboard-info" bindtap="viewLeaderboardDetail">📋 说明</view>
    </view>
    
    <view class="leaderboard-list">
      <view class="leaderboard-item {{item.isCurrentUser ? 'current-user' : ''}}" 
            wx:for="{{leaderboard}}" 
            wx:key="rank">
        <view class="rank">{{item.rank}}</view>
        <view class="user-info">
          <view class="user-avatar">{{item.avatar}}</view>
          <view class="user-details">
            <text class="user-name">{{item.name}}</text>
            <text class="user-level">Lv.{{item.level}}</text>
          </view>
        </view>
        <view class="user-points">{{item.points}} 积分</view>
      </view>
    </view>
  </view>

  <!-- 刷新按钮 -->
  <view class="refresh-btn" bindtap="refreshData">🔄 刷新</view>
</view>

