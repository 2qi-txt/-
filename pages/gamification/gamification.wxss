/* pages/gamification/gamification.wxss - 电竞风格 */
.container {
  padding: 40rpx 30rpx 60rpx;
  min-height: 100vh;
}

/* 标题栏 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 0;
  position: relative;
}

.header::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, var(--primary-glow), transparent);
  opacity: 0.3;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary-light);
  text-shadow: 0 0 30rpx var(--primary-glow);
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  position: relative;
  z-index: 1;
}

.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--primary-light);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.list { 
  display: flex; 
  flex-direction: column; 
  gap: 16rpx; 
}

.list-item { 
  font-size: 28rpx; 
  color: rgba(255,255,255,0.85); 
  line-height: 1.7;
  padding-left: 24rpx;
  position: relative;
}

.list-item::before {
  content: '›';
  position: absolute;
  left: 0;
  color: var(--primary-light);
  font-weight: bold;
}

.btn {
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx var(--primary-glow);
}

.btn:active {
  transform: scale(0.97);
  filter: brightness(1.1);
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  transition: all 0.3s ease;
}

.tab-item.active {
  color: white;
  font-weight: bold;
  background: rgba(255,255,255,0.3);
  border-radius: 12rpx;
  margin: 4rpx;
}

/* 內容區域 */
.content {
  margin-top: 20rpx;
}

/* 個人資料卡片 */
.profile-card {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  backdrop-filter: blur(10rpx);
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-section {
  position: relative;
  margin-right: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: white;
}

.level-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  background: #FF6B6B;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.points {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: bold;
}

/* 經驗值條 */
.experience-bar {
  margin-bottom: 20rpx;
}

.exp-label {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-bottom: 8rpx;
}

.exp-bar {
  height: 12rpx;
  background: #e9ecef;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.exp-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #357ABD);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.exp-text {
  font-size: 20rpx;
  color: #7f8c8d;
}

/* 連續使用天數 */
.streak-section {
  text-align: center;
}

.streak-label {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: bold;
}

/* 統計數據 */
.stats-section {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #7f8c8d;
}

/* 最近成就 */
.recent-achievements {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.achievement-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.achievement-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.achievement-info {
  flex: 1;
}

.achievement-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.achievement-date {
  font-size: 20rpx;
  color: #7f8c8d;
}

.achievement-points {
  font-size: 22rpx;
  color: #4A90E2;
  font-weight: bold;
}

/* 成就網格 */
.achievements-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.achievement-card {
  background: rgba(255,255,255,0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
}

.achievement-card.unlocked {
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: white;
}

.achievement-card:active {
  transform: scale(0.98);
}

.achievement-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.achievement-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #2c3e50;
}

.achievement-card.unlocked .achievement-title {
  color: white;
}

.achievement-description {
  font-size: 20rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.achievement-card.unlocked .achievement-description {
  color: rgba(255,255,255,0.9);
}

.achievement-progress {
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 8rpx;
  background: #e9ecef;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #357ABD);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 18rpx;
  color: #7f8c8d;
}

.unlocked-badge {
  background: #4CAF50;
  color: white;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  margin-bottom: 12rpx;
}

.achievement-points {
  font-size: 20rpx;
  color: #4A90E2;
  font-weight: bold;
}

.achievement-card.unlocked .achievement-points {
  color: white;
}

/* 任務列表 */
.task-list, .challenge-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item, .challenge-item {
  background: rgba(255,255,255,0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
}

.task-item.completed, .challenge-item.completed {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
}

.task-item:active, .challenge-item:active {
  transform: scale(0.98);
}

.task-icon, .challenge-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.task-content, .challenge-content {
  flex: 1;
}

.task-title, .challenge-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.task-item.completed .task-title,
.challenge-item.completed .challenge-title {
  color: white;
}

.task-description, .challenge-description {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-bottom: 12rpx;
}

.task-item.completed .task-description,
.challenge-item.completed .challenge-description {
  color: rgba(255,255,255,0.9);
}

.task-progress, .challenge-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-text {
  font-size: 20rpx;
  color: #7f8c8d;
}

.task-item.completed .progress-text,
.challenge-item.completed .progress-text {
  color: white;
}

.challenge-deadline {
  font-size: 20rpx;
  color: #FF6B6B;
  margin-top: 8rpx;
}

.task-actions, .challenge-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.task-points, .challenge-points {
  font-size: 20rpx;
  color: #4A90E2;
  font-weight: bold;
}

.task-item.completed .task-points,
.challenge-item.completed .challenge-points {
  color: white;
}

.task-btn, .challenge-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.task-btn.claim, .challenge-btn.claim {
  background: #4A90E2;
  color: white;
}

.task-btn.completed, .challenge-btn.completed {
  background: rgba(255,255,255,0.3);
  color: white;
}

.task-btn:active, .challenge-btn:active {
  transform: scale(0.95);
}

/* 排行榜 */
.leaderboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.leaderboard-info {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
}

.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.leaderboard-item {
  background: rgba(255,255,255,0.95);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
}

.leaderboard-item.current-user {
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: white;
}

.leaderboard-item:active {
  transform: scale(0.98);
}

.rank {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-right: 20rpx;
  min-width: 60rpx;
}

.leaderboard-item.current-user .rank {
  color: white;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.leaderboard-item.current-user .user-name {
  color: white;
}

.user-level {
  font-size: 20rpx;
  color: #7f8c8d;
}

.leaderboard-item.current-user .user-level {
  color: rgba(255,255,255,0.8);
}

.user-points {
  font-size: 24rpx;
  font-weight: bold;
  color: #4A90E2;
}

.leaderboard-item.current-user .user-points {
  color: white;
}

/* 刷新按鈕 */
.refresh-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
  transition: all 0.3s ease;
}

.refresh-btn:active {
  transform: scale(0.95);
}

/* 響應式設計 */
@media (max-width: 750rpx) {
  .achievements-grid {
    grid-template-columns: 1fr;
  }
  
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .task-item, .challenge-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 16rpx;
  }
  
  .task-actions, .challenge-actions {
    align-self: flex-end;
    flex-direction: row;
    gap: 16rpx;
  }
}

