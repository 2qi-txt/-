/* 隐私政策 - 电竞风格 */
.container { 
  padding: 40rpx 30rpx 60rpx; 
  min-height: 100vh;
}

.header { 
  text-align: center; 
  margin-bottom: 40rpx;
  padding: 40rpx 0;
  position: relative;
}

.header::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, var(--primary-glow), transparent);
  opacity: 0.3;
}

.title { 
  font-size: 48rpx; 
  font-weight: 900; 
  color: var(--primary-light);
  text-shadow: 0 0 30rpx var(--primary-glow);
  position: relative;
  z-index: 1;
  letter-spacing: 4rpx;
}

.subtitle { 
  font-size: 26rpx; 
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.card { 
  background: var(--card-bg);
  border-radius: 24rpx; 
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.section-title { 
  font-size: 32rpx; 
  font-weight: 800; 
  color: var(--primary-light);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.paragraph { 
  font-size: 28rpx; 
  color: rgba(255,255,255,0.8); 
  line-height: 1.8; 
}

.list { 
  display: flex; 
  flex-direction: column; 
  gap: 16rpx; 
}

.list-item { 
  font-size: 28rpx; 
  color: rgba(255,255,255,0.85); 
  line-height: 1.7;
  padding-left: 24rpx;
  position: relative;
}

.list-item::before {
  content: '›';
  position: absolute;
  left: 0;
  color: var(--primary-light);
  font-weight: bold;
}

.contact { 
  display: flex; 
  flex-direction: column; 
  gap: 16rpx; 
}

.contact-item { 
  font-size: 28rpx; 
  color: rgba(255,255,255,0.85);
  padding-left: 24rpx;
  position: relative;
}

.contact-item::before {
  content: '›';
  position: absolute;
  left: 0;
  color: var(--primary-light);
  font-weight: bold;
}

.actions { 
  margin-top: 32rpx; 
  display: flex; 
  justify-content: center; 
}

.btn { 
  height: 88rpx;
  padding: 0 60rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff; 
  border: none; 
  border-radius: 44rpx; 
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx var(--primary-glow);
}

.btn:active {
  transform: scale(0.97);
  filter: brightness(1.1);
}
