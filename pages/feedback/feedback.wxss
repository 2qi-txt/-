/* 意见反馈 - 电竞风格 */
.container { 
  padding: 40rpx 30rpx 60rpx; 
  min-height: 100vh;
}

.header { 
  text-align: center; 
  margin-bottom: 40rpx;
  padding: 40rpx 0;
  position: relative;
}

.header::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, var(--primary-glow), transparent);
  opacity: 0.3;
}

.title { 
  font-size: 48rpx; 
  font-weight: 900; 
  color: var(--primary-light);
  text-shadow: 0 0 30rpx var(--primary-glow);
  position: relative;
  z-index: 1;
  letter-spacing: 4rpx;
}

.subtitle { 
  font-size: 26rpx; 
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.card { 
  background: var(--card-bg);
  border-radius: 24rpx; 
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  border: 1rpx solid var(--card-border);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.form-item { 
  margin-bottom: 28rpx; 
}

.label { 
  font-size: 26rpx; 
  color: rgba(255,255,255,0.8);
  margin-bottom: 12rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.input { 
  width: 100%; 
  box-sizing: border-box; 
  background: rgba(0,0,0,0.3); 
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx; 
  padding: 20rpx 24rpx; 
  font-size: 28rpx; 
  min-height: 80rpx; 
  line-height: 40rpx;
  color: #fff;
}

.input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 20rpx var(--primary-glow);
}

.textarea { 
  width: 100%; 
  box-sizing: border-box; 
  background: rgba(0,0,0,0.3); 
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx; 
  padding: 20rpx 24rpx; 
  font-size: 28rpx; 
  min-height: 200rpx; 
  line-height: 1.6;
  color: #fff;
}

.textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 20rpx var(--primary-glow);
}

.hint { 
  font-size: 22rpx; 
  color: rgba(255,255,255,0.5); 
  margin-top: 10rpx; 
  white-space: normal; 
  word-break: break-word; 
}

.picker { 
  width: 100%; 
  box-sizing: border-box; 
  background: rgba(0,0,0,0.3);
  border: 2rpx solid var(--card-border);
  border-radius: 16rpx; 
  padding: 20rpx 24rpx;
  color: #fff;
  font-size: 28rpx;
  white-space: normal; 
  word-break: break-word; 
}

.images { 
  display: flex; 
  gap: 16rpx; 
}

.img { 
  width: 160rpx; 
  height: 160rpx; 
  border-radius: 16rpx; 
  background: rgba(0,0,0,0.3);
  border: 2rpx solid var(--card-border);
}

.img.add { 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  color: var(--primary-light); 
  border: 2rpx dashed var(--card-border);
  font-size: 48rpx;
  font-weight: 300;
}

.actions { 
  display: flex; 
  gap: 20rpx; 
  margin-top: 32rpx; 
}

.btn { 
  flex: 1;
  height: 88rpx;
  border: none; 
  border-radius: 44rpx; 
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn.primary { 
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx var(--primary-glow);
}

.btn.secondary { 
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
}

.btn:active {
  transform: scale(0.97);
  filter: brightness(1.1);
}

.section { 
  margin-top: 40rpx; 
}

.section-title { 
  font-size: 32rpx; 
  font-weight: 800; 
  color: var(--primary-light);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.list { 
  display: flex; 
  flex-direction: column; 
  gap: 16rpx; 
}

.item { 
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx; 
  padding: 24rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.item-title { 
  font-size: 28rpx; 
  font-weight: 700; 
  color: #fff;
}

.item-desc { 
  font-size: 24rpx; 
  color: rgba(255,255,255,0.7); 
  margin-top: 10rpx; 
  display: -webkit-box; 
  -webkit-line-clamp: 2; 
  -webkit-box-orient: vertical; 
  overflow: hidden; 
}

.item-meta { 
  font-size: 22rpx; 
  color: rgba(255,255,255,0.5); 
  margin-top: 12rpx; 
}
